<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tệp Anh 7" Width="1000" Height="640" MinWidth="640" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#1D1D1F"
        UseLayoutRounding="True">

  <Window.Resources>
    <!-- Nút tròn đỏ / vàng / xanh -->
    <Style x:Key="Light" TargetType="Button">
      <Setter Property="Width" Value="13"/>
      <Setter Property="Height" Value="13"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse x:Name="E" Fill="{TemplateBinding Background}" Stroke="#26000000" StrokeThickness="0.6"/>
              <ContentPresenter x:Name="G" TextElement.FontSize="9" TextElement.FontWeight="Bold" TextElement.Foreground="#99000000"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" Visibility="Hidden"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="G" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Nút phẳng (thanh công cụ, thanh bên, đường dẫn) -->
    <Style x:Key="Flat" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#1D1D1F"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#14000000"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Mục file: dạng lưới -->
    <DataTemplate x:Key="GridTpl">
      <StackPanel Width="100" Margin="4,6">
        <Image Source="{Binding Icon}" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                   MaxHeight="34" FontSize="12" Margin="2,5,2,0"/>
      </StackPanel>
    </DataTemplate>

    <!-- Mục file: dạng danh sách -->
    <DataTemplate x:Key="ListTpl">
      <Grid Height="26">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition Width="130"/>
        </Grid.ColumnDefinitions>
        <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{Binding DateText}" VerticalAlignment="Center" Foreground="#6E6E73"/>
        <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" Foreground="#6E6E73" TextAlignment="Right" Margin="0,0,14,0"/>
        <TextBlock Grid.Column="4" Text="{Binding Kind}" VerticalAlignment="Center" Foreground="#6E6E73" TextTrimming="CharacterEllipsis"/>
      </Grid>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="WrapTpl"><WrapPanel/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="StackTpl"><VirtualizingStackPanel/></ItemsPanelTemplate>

    <Style x:Key="Item" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="Margin" Value="2,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="B" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#0F000000"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="B" Property="Background" Value="#D5E3FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Shell" Margin="14" CornerRadius="12" Background="#FCFCFE" BorderBrush="#1F000000" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.28" Color="#1E1440"/>
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== Thanh bên ===== -->
      <Border x:Name="Side" CornerRadius="12,0,0,12" Background="#F0EEF7" BorderBrush="#14000000" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel x:Name="Lights" DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,16,0,14" Background="Transparent">
            <Button x:Name="BtnClose" Style="{StaticResource Light}" Background="#FF5F57" Content="×" ToolTip="Đóng"/>
            <Button x:Name="BtnMin" Style="{StaticResource Light}" Background="#FEBC2E" Content="−" ToolTip="Thu nhỏ"/>
            <Button x:Name="BtnZoom" Style="{StaticResource Light}" Background="#28C840" Content="+" ToolTip="Phóng to"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8,0,8,12">
              <TextBlock Text="Mục ưa thích" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" Margin="10,4,0,4"/>
              <StackPanel x:Name="SideFav"/>
              <TextBlock Text="Vị trí" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" Margin="10,14,0,4"/>
              <StackPanel x:Name="SideLoc"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ===== Nội dung ===== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="54"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <DockPanel x:Name="Toolbar" Grid.Row="0" Background="Transparent" Margin="10,0,12,0" LastChildFill="True">
          <Button x:Name="BtnBack" Style="{StaticResource Flat}" ToolTip="Quay lại (Alt+←)" DockPanel.Dock="Left">
            <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
          </Button>
          <Button x:Name="BtnFwd" Style="{StaticResource Flat}" ToolTip="Tiến tới (Alt+→)" DockPanel.Dock="Left">
            <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
          </Button>
          <Border DockPanel.Dock="Right" CornerRadius="8" Background="#0D000000" Width="190" Height="30" Margin="8,0,0,0">
            <Grid>
              <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#8E8E93"
                         VerticalAlignment="Center" Margin="10,0,0,0"/>
              <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0" Margin="30,0,8,0" VerticalContentAlignment="Center"/>
              <TextBlock x:Name="SearchHint" Text="Tìm trong thư mục này" Foreground="#A0A0A8" IsHitTestVisible="False"
                         VerticalAlignment="Center" Margin="32,0,0,0"/>
            </Grid>
          </Border>
          <Button x:Name="BtnEmpty" Style="{StaticResource Flat}" DockPanel.Dock="Right" Visibility="Collapsed" Foreground="#D13438"
                  Content="Dọn sạch Thùng rác" Margin="4,0,0,0"/>
          <Button x:Name="BtnRestore" Style="{StaticResource Flat}" DockPanel.Dock="Right" Visibility="Collapsed"
                  Content="Khôi phục" Margin="4,0,0,0"/>
          <Button x:Name="BtnNewFolder" Style="{StaticResource Flat}" ToolTip="Thư mục mới" DockPanel.Dock="Right">
            <TextBlock Text="&#xE8F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/>
          </Button>
          <Border DockPanel.Dock="Right" CornerRadius="8" Background="#0D000000" Margin="6,0" Padding="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnGrid" Style="{StaticResource Flat}" ToolTip="Xem dạng lưới" Padding="8,4">
                <TextBlock Text="&#xF0E2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
              </Button>
              <Button x:Name="BtnList" Style="{StaticResource Flat}" ToolTip="Xem dạng danh sách" Padding="8,4">
                <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
              </Button>
            </StackPanel>
          </Border>
          <TextBlock x:Name="TxtTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"
                     TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Tiêu đề cột (chỉ hiện ở dạng danh sách) -->
        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid x:Name="ListHeader" Height="24" Margin="18,0,18,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="30"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Tên" FontSize="11.5" Foreground="#8E8E93" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Ngày sửa" FontSize="11.5" Foreground="#8E8E93" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="Kích thước" FontSize="11.5" Foreground="#8E8E93" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,14,0"/>
            <TextBlock Grid.Column="4" Text="Loại" FontSize="11.5" Foreground="#8E8E93" VerticalAlignment="Center"/>
          </Grid>
          <ListBox x:Name="FileList" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="10,2,10,6"
                   SelectionMode="Extended" ItemContainerStyle="{StaticResource Item}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
          <TextBlock x:Name="TxtEmpty" Grid.Row="1" Text="Thư mục trống" Foreground="#A0A0A8" FontSize="14"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>

        <!-- Thanh đường dẫn + đếm mục -->
        <Border Grid.Row="2" BorderBrush="#14000000" BorderThickness="0,1,0,0" Padding="12,0,22,0" CornerRadius="0,0,12,0">
          <DockPanel>
            <TextBlock x:Name="TxtCount" DockPanel.Dock="Right" FontSize="11.5" Foreground="#8E8E93" VerticalAlignment="Center"/>
            <StackPanel x:Name="PathBar" Orientation="Horizontal" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
