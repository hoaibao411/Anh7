<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start — Anh 7" Width="680" Height="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#1B1B2F" UseLayoutRounding="True">

  <Window.Resources>
    <Style x:Key="Flat" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#1B1B2F"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#14000000"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Ô app đã ghim -->
    <DataTemplate x:Key="TileTpl">
      <StackPanel Width="96" Margin="2,6">
        <Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Margin="4,6,4,0"/>
      </StackPanel>
    </DataTemplate>

    <!-- Dòng app trong danh sách -->
    <DataTemplate x:Key="RowTpl">
      <StackPanel Orientation="Horizontal" Height="36">
        <Image Source="{Binding Icon}" Width="26" Height="26" Margin="6,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13.5"/>
      </StackPanel>
    </DataTemplate>

    <Style x:Key="Item" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="B" CornerRadius="10" Background="Transparent" Padding="2" Margin="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#12000000"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="B" Property="Background" Value="#1F6D6AF0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="14" CornerRadius="18" BorderBrush="#99FFFFFF" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7FFFFFF" Offset="0"/>
        <GradientStop Color="#F2F3F0FF" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.3" Color="#2A1E5C"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="64"/>
      </Grid.RowDefinitions>

      <!-- Ô tìm -->
      <Border Grid.Row="0" Margin="26,24,26,8" Height="42" CornerRadius="21" Background="#FFFFFF" BorderBrush="#22000000" BorderThickness="1">
        <Grid>
          <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="#6D6AF0"
                     VerticalAlignment="Center" Margin="16,0,0,0"/>
          <TextBox x:Name="TxtQ" Background="Transparent" BorderThickness="0" FontSize="14" Margin="44,0,16,0" VerticalContentAlignment="Center"/>
          <TextBlock x:Name="QHint" Text="Tìm ứng dụng" Foreground="#9A9AA8" FontSize="14" IsHitTestVisible="False"
                     VerticalAlignment="Center" Margin="46,0,0,0"/>
        </Grid>
      </Border>

      <!-- Tiêu đề mục -->
      <DockPanel Grid.Row="1" Margin="34,10,26,4">
        <Button x:Name="BtnAll" DockPanel.Dock="Right" Style="{StaticResource Flat}" Background="#0D000000" Padding="12,4">
          <TextBlock x:Name="TxtAllBtn" Text="Tất cả ứng dụng  ›" FontSize="12.5"/>
        </Button>
        <TextBlock x:Name="TxtSection" Text="Đã ghim" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>

      <!-- Đã ghim (lưới) / Tất cả + kết quả tìm (danh sách) -->
      <Grid Grid.Row="2" Margin="22,4,22,6">
        <ListBox x:Name="PinList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource Item}"
                 ItemTemplate="{StaticResource TileTpl}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        </ListBox>
        <ListBox x:Name="AllList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource Item}"
                 ItemTemplate="{StaticResource RowTpl}" Visibility="Collapsed"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        <TextBlock x:Name="TxtNone" Text="Không tìm thấy ứng dụng" Foreground="#9A9AA8" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
      </Grid>

      <!-- Thanh dưới: người dùng + nguồn -->
      <Border Grid.Row="3" CornerRadius="0,0,18,18" Background="#0A000000" BorderBrush="#14000000" BorderThickness="0,1,0,0">
        <DockPanel Margin="26,0">
          <Button x:Name="BtnPower" DockPanel.Dock="Right" Style="{StaticResource Flat}" ToolTip="Nguồn" Padding="10">
            <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
          </Button>
          <Button x:Name="BtnSettings" DockPanel.Dock="Right" Style="{StaticResource Flat}" ToolTip="Cài đặt" Padding="10">
            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
          </Button>
          <Button x:Name="BtnFiles" DockPanel.Dock="Right" Style="{StaticResource Flat}" ToolTip="Tệp Anh 7" Padding="10">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
          </Button>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="34" Height="34" CornerRadius="17">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#B65FD9" Offset="0"/>
                  <GradientStop Color="#3F7FF0" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <TextBlock x:Name="TxtInitial" Foreground="White" FontWeight="SemiBold" FontSize="15"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="TxtUser" FontSize="13.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
